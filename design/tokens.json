{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "Football Value AI",
    "version": "1.0.0",
    "platform": "android",
    "default_theme": "dark"
  },
  "color": {
    "dark": {
      "bg": "#0B0F14",
      "surface": "#121821",
      "surfaceAlt": "#1A2230",
      "border": "#243044",
      "text": "#EAF0F7",
      "textMuted": "#8A94A6",
      "primary": "#00D68F",
      "primaryPressed": "#00B87A",
      "accent": "#4CD7F6",
      "warning": "#FFB020",
      "danger": "#FF5A5F",
      "info": "#2F80ED",
      "priorityA": "#00D68F",
      "priorityB": "#4CD7F6",
      "priorityC": "#FFB020",
      "priorityD": "#8A94A6",
      "noBet": "#5A6473",
      "live": "#FF4D4F",
      "overlay": "rgba(0,0,0,0.55)"
    },
    "light": {
      "bg": "#F6F8FA",
      "surface": "#FFFFFF",
      "surfaceAlt": "#EEF2F6",
      "border": "#DDE3EA",
      "text": "#111827",
      "textMuted": "#5B6675",
      "primary": "#00875A",
      "primaryPressed": "#006B47",
      "accent": "#0077B6",
      "warning": "#B26A00",
      "danger": "#C62828",
      "info": "#1565C0",
      "priorityA": "#00875A",
      "priorityB": "#0077B6",
      "priorityC": "#B26A00",
      "priorityD": "#5B6675",
      "noBet": "#6B7280",
      "live": "#D32F2F",
      "overlay": "rgba(0,0,0,0.35)"
    }
  },
  "typography": {
    "fontFamily": "Inter",
    "fontFamilyNumeric": "JetBrainsMono",
    "scale": {
      "display": { "size": 28, "weight": 700, "lineHeight": 34 },
      "h1": { "size": 22, "weight": 700, "lineHeight": 28 },
      "h2": { "size": 18, "weight": 700, "lineHeight": 24 },
      "section": { "size": 13, "weight": 700, "lineHeight": 18, "letterSpacing": 1.04, "uppercase": true },
      "body": { "size": 15, "weight": 400, "lineHeight": 21 },
      "bodyStrong": { "size": 15, "weight": 600, "lineHeight": 21 },
      "caption": { "size": 12, "weight": 400, "lineHeight": 16 },
      "badge": { "size": 12, "weight": 800, "lineHeight": 14 },
      "number": { "size": 20, "weight": 700, "lineHeight": 24, "tabular": true }
    }
  },
  "space": {
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48
  },
  "radius": {
    "badge": 8,
    "button": 12,
    "card": 16,
    "sheet": 24,
    "pill": 999
  },
  "elevation": {
    "none": "none",
    "cardLight": "0 2px 8px rgba(0,0,0,0.06)",
    "sheet": "0 -8px 24px rgba(0,0,0,0.35)"
  },
  "layout": {
    "screenPadding": 16,
    "gutter": 12,
    "minTouchTarget": 48,
    "matchCardHeight": 104,
    "bottomNavHeight": 64,
    "maxContentWidth": 720
  },
  "breakpoints": {
    "compact": 360,
    "medium": 600,
    "expanded": 840
  },
  "motion": {
    "fast": 120,
    "normal": 220,
    "slow": 320,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "priority": {
    "A": { "label": "Opportunité forte", "color": "priorityA", "notify": true },
    "B": { "label": "Opportunité intéressante", "color": "priorityB", "notify": true },
    "C": { "label": "À surveiller", "color": "priorityC", "notify": false },
    "D": { "label": "Non retenue", "color": "priorityD", "notify": false },
    "NO_BET": { "label": "Aucune opportunité fiable", "color": "noBet", "notify": false }
  },
  "accessibility": {
    "minContrastText": 4.5,
    "minContrastGraphic": 3.0,
    "maxTextScale": 1.3,
    "focusRingWidth": 2
  }
}
