# ============================================================================
# FOOTBALL VALUE AI — variables d'environnement (EXEMPLE, AUCUN SECRET)
# Copier en `.env` et remplir localement. Ne jamais committer `.env`.
# ============================================================================

ENV=development
LOG_LEVEL=INFO
TZ=UTC

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=            # vide en production mobile
MAX_REQUEST_BODY_MB=2

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://fva:fva_dev_only@localhost:5432/football_value_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=300

# --- Sécurité --------------------------------------------------------------
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_48_chars_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Fournisseurs (clés côté serveur uniquement) ---------------------------
ODDS_API_KEY=
ODDS_API_REGIONS=eu
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=3
PROVIDER_QUOTA_ALERT_PCT=80

# --- Notifications ---------------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/fcm-service-account.json

# --- Modèles ---------------------------------------------------------------
MODEL_ARTIFACT_DIR=/var/lib/fva/models
MODEL_ACTIVE_CODE=ensemble
MODEL_MAX_ODDS_AGE_SECONDS=120

# --- Fonctionnalités -------------------------------------------------------
FEATURE_LIVE=false
FEATURE_PLAYER_MARKETS=false
FEATURE_COMBOS=false
FEATURE_MANUAL_ODDS=true

# --- Légal -----------------------------------------------------------------
MIN_AGE=18
LEGAL_COUNTRY_SCOPE=BF
DISCLAIMER_VERSION=2026-10-30

# --- Observabilité ---------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_ENABLED=true
