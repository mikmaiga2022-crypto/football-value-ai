# ============================================================================
# FOOTBALL VALUE AI — configuration API (EXEMPLE, AUCUN SECRET)
# Copier en `backend/.env` pour le développement local. Ne jamais committer.
# Préfixe obligatoire : FVA_ (voir app/core/config.py).
# ============================================================================

# --- Identité ---------------------------------------------------------------
FVA_ENVIRONMENT=dev                 # dev | test | staging | prod
FVA_API_VERSION=1.0.0
FVA_LOG_LEVEL=INFO
FVA_DOCS_ENABLED=true               # doit être false en staging/prod

# --- Base de données -------------------------------------------------------
# PostgreSQL 16 en production. SQLite (aiosqlite) est réservé aux tests.
FVA_DATABASE_URL=postgresql+asyncpg://fva:fva@localhost:5432/fva
FVA_DB_ECHO=false
FVA_DB_POOL_SIZE=5
FVA_DB_MAX_OVERFLOW=5

# --- Redis / Celery --------------------------------------------------------
FVA_REDIS_URL=redis://localhost:6379/0
FVA_CELERY_BROKER_URL=redis://localhost:6379/1
FVA_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Authentification ------------------------------------------------------
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
FVA_JWT_SECRET=change-me-32-bytes-minimum
FVA_JWT_ALGORITHM=HS256
FVA_JWT_ISSUER=football-value-ai
FVA_ACCESS_TOKEN_TTL_SECONDS=900
FVA_REFRESH_TOKEN_TTL_DAYS=30
FVA_PASSWORD_MIN_LENGTH=10
FVA_MAX_LOGIN_ATTEMPTS=5
# Verrouillage progressif (secondes), séparé par des virgules.
FVA_LOCKOUT_SECONDS=60,300,900

# --- Quotas fournisseurs (mode pilote 0 €, docs/09 §3.3) -------------------
FVA_ODDS_MONTHLY_CREDIT_BUDGET=270
FVA_ODDS_PROVIDER_HARD_LIMIT=500
FVA_ODDS_BATCH_PER_COMPETITION_DAY=3
FVA_COVERAGE_SERVED_SLOTS=3
FVA_COVERAGE_OPPORTUNISTIC_SLOTS=2

# --- Divers ----------------------------------------------------------------
# Vide en production mobile : l'application Android n'est pas un navigateur.
FVA_CORS_ORIGINS=
FVA_REQUEST_TIMEOUT_SECONDS=10

# --- Fournisseurs (Phase 3) ------------------------------------------------
# Aucune clé n'est utilisée par l'API en Phase 2 et aucune n'est exposée à Flutter.
# Les clés seront lues uniquement par les workers de collecte en Phase 3.
# ODDS_API_KEY=
# API_FOOTBALL_KEY=
